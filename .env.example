# AI analysis mode: "mock" (default, no network) or "live" (calls the proxy below).
EXPO_PUBLIC_AI_MODE=mock

# HTTPS endpoint that accepts { imageBase64, mimeType, locale } and returns:
# { analysis: ScanAnalysis, model?: string }
# Only used when EXPO_PUBLIC_AI_MODE=live.
EXPO_PUBLIC_AI_PROXY_URL=
